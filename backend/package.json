{
  "name": "fst-portfolio-monitor",
  "version": "1.0.0",
  "description": "Автоматический мониторинг портфельных компаний ФСТ НТИ через ЕГРЮЛ, HH.ru, Роспатент и Яндекс.Новости",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/schedulers/portfolioMonitor.js",
    "api": "node src/server.js",
    "monitor:full": "node -e \"import('./src/schedulers/portfolioMonitor.js').then(m => m.runFullMonitoring())\"",
    "monitor:egrul": "node -e \"import('./src/schedulers/portfolioMonitor.js').then(m => m.runManualMonitoring('egrul'))\"",
    "monitor:patents": "node -e \"import('./src/schedulers/portfolioMonitor.js').then(m => m.runManualMonitoring('patents'))\"",
    "monitor:news": "node -e \"import('./src/schedulers/portfolioMonitor.js').then(m => m.runManualMonitoring('news'))\"",
    "test": "node --test src/**/*.test.js"
  },
  "keywords": [
    "portfolio",
    "monitoring",
    "venture",
    "fund",
    "fst",
    "parser",
    "egrul",
    "hh.ru",
    "rospatent"
  ],
  "author": "FST NTI",
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "node-telegram-bot-api": "^0.66.0",
    "openai": "^6.31.0",
    "pdf-parse": "^2.4.5",
    "socks-proxy-agent": "^8.0.2",
    "swagger-ui-express": "^5.0.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
