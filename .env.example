# VentureOS Environment Variables

# ======================================
# AI / LLM Provider API Keys
# ======================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
YANDEXGPT_API_KEY=your-yandex-gpt-api-key-here

# ======================================
# Integram Database (ai2o.ru)
# ======================================
INTEGRAM_SERVER_URL=ai2o.ru
INTEGRAM_SYSTEM_USERNAME=d
INTEGRAM_SYSTEM_PASSWORD=d

# FST Database
INTEGRAM_FST_DB=fst
INTEGRAM_FST_USERNAME=d
INTEGRAM_FST_PASSWORD=d

# ======================================
# KAG (Knowledge Augmented Graph)
# ======================================
KAG_SERVER_URL=http://localhost:8000
KAG_API_KEY=your-kag-api-key-here

# ======================================
# Backend Configuration
# ======================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ======================================
# Frontend Configuration
# ======================================
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
VITE_FST_SERVER=https://ai2o.ru
VITE_FST_DB=fst
VITE_FST_LOGIN=d
VITE_FST_PASSWORD=d

# ======================================
# Telegram Bot
# ======================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# ======================================
# GitHub (for Koda AI automation)
# ======================================
GITHUB_TOKEN=ghp_your-github-token-here

# ======================================
# Authentication & Security
# ======================================
JWT_SECRET=your-jwt-secret-key-here
SESSION_SECRET=your-session-secret-here

# ======================================
# Proxy Configuration (optional)
# ======================================
SOCKS_PROXY_HOST=localhost
SOCKS_PROXY_PORT=1080
SOCKS_PROXY=socks5://127.0.0.1:9050

# ======================================
# Portfolio Monitoring (Issue #11)
# ======================================
# Yandex API for sentiment analysis
YANDEX_API_KEY=your-yandex-api-key-here
YANDEX_FOLDER_ID=your-yandex-folder-id-here

# Monitoring schedule (cron format)
PORTFOLIO_MONITOR_ENABLED=true
PORTFOLIO_MONITOR_DAILY=0 9 * * *
PORTFOLIO_MONITOR_WEEKLY=0 8 * * 1
PORTFOLIO_MONITOR_MONTHLY=0 10 1 * *

# ======================================
# Deployment
# ======================================
DEPLOY_TARGET=production
DEPLOY_HOST=fst.drondoc.ru
DEPLOY_USER=deploy
DEPLOY_PATH=/var/www/ventureos

# ======================================
# Monitoring & Logging
# ======================================
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn-here

# ======================================
# Database Backup
# ======================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
